# Install as .github/workflows/light-check.yml in a dependent repository.
#
# WHY THIS TEMPLATE EXISTS AT ALL (2026-09-21, practice: cite-the-incident).
# `two-check-levels` tells every adopter to name a fast check and a full
# check. Precedent shipped the RULE and never shipped a SHAPE. So twelve
# repositories each invented their own `light-check.yml`, uncoordinated, and
# not one of them got the discipline the other templates here have -- one
# job, and a `paths:` filter. Measured on the 2026-09-01..19 usage export:
# 609 billed minutes across those twelve, 23.5% of the whole account, the
# single largest line on the bill. We caused twelve variants by publishing a
# rule without a shape. See spec/BILLING_FLOOR.md.
#
# THE ENGINE OWNS THIS FILE (2026-09-27). Every "Update Vendors" writes it
# from this template, unmodified, over whatever a consumer has at
# .github/workflows/light-check.yml, and removes any other workflow upstream
# does not ship and the person did not approve in their own words. Nobody is
# asked (Morgan: "It should definitely definitely use the newer version from
# upstream ... so it shouldn't ask"). See CI_CONVERGES_KINDS in
# tools/precedent_vendor_engine.py.
#
# So a repository's own light-check command does not belong here. Until
# 2026-09-27 this header told an adopter to copy it in, and that advice is
# what kept twelve hand-made variants alive. A repository's own checks run in
# its local push check, before every push; GitHub only re-checks what is
# about to reach main, on a clean machine.
#
# THE 2026-09-20 SWEEP deleted nine live checks across nine repositories on
# the theory that a filename absent from this tree meant a retired file, and
# those checks were lost. Replacing a hand-made copy of this file is not that:
# the checks it ran are the local push check's, so nothing stops running; and
# the refresh only replaces a file git holds with no uncommitted edits, so
# the old content stays in history. If a repository's own command is not in
# its local gate, the fix is to run it there.
#
# ONE JOB, NOT TWO. GitHub bills a job for at least one whole minute however
# fast it finishes, so a second job that exists to DECIDE whether to run the
# first costs exactly the minute it was deciding whether to spend. Two
# templates here were split that way and both were folded back. The full
# arithmetic is in precedent-check.yml.template's header and in
# spec/BILLING_FLOOR.md; the short version is that no debounce, cache or
# early-exit is free once a runner has been allocated.
#
# THE `paths:` FILTER IS THE ONLY GENUINELY FREE LEVER IN THIS FILE, because
# GitHub evaluates it BEFORE allocating a runner. A run it skips costs
# nothing at all -- not a rounded-up minute, nothing. Everything else here
# makes a run cheaper; this makes runs not happen. Spend your attention on
# getting the list right: it should name what your light check actually
# INSPECTS, and nothing else.
#
# SINCE 2026-09-25 THIS FILE CARRIES NO `paths:` FILTER: it runs only on a
# pull request into main, which is rare enough that skipping one by file
# type saves little and risks the one check guarding main. See `on:` below.
#
# DO NOT EDIT THIS FILE IN A CONSUMING REPOSITORY. The next "Update Vendors"
# replaces any edit with this template. A change to when it runs belongs here,
# upstream, with the person's approval (practice: ci-workflow-approved). A
# consuming repo's own copy ran on every push to main for four days, 2026-09-25,
# because one session put back a trigger another had removed.
name: Light check

on:
  # PULL REQUESTS INTO MAIN (spec/BRANCH_TIERS_PLAN.md, 2026-09-25), and in
  # a public repository pushes to main too (2026-09-27, below). This is a
  # repository's one GitHub test: pre-staging,
  # staging and working branches are checked by the local push check before
  # every push, and GitHub's job is only to re-check what is about to reach
  # main on a clean machine that has none of the session's private sources.
  # Morgan: "to main, you get all those local tests AND the most important
  # GitHub test" (strength: decided).
  #
  # No `paths:` filter: a pull request into main is rare, and the one check
  # that guards main should not skip a change because of which files it
  # touched. `synchronize` IS here, unlike the working-branch shape this
  # file used to have: the pull request into main is staging, which moves
  # only on a Promote, and the head that merges is the head that must have
  # been checked.
  #
  # THAT REASONING ASSUMES A STAGING TIER. In a repository whose working
  # branches open their pull requests straight into main, the head moves on
  # every push, and `synchronize` bills a run for each one. Today the
  # `[skip ci]` backstop below hides that cost. Such a repository must
  # re-decide this line -- keep it, or drop it and re-run by hand before
  # merging -- before that backstop is removed (a consuming repo found the
  # gap on 2026-09-25, installing this file).
  #
  # The `[skip ci]` line the commit hook adds in a private repo is kept as a
  # backstop until every install has this file (Morgan, 2026-09-25: "Backstops
  # are good especially on this issue. We'll keep it until we're 100% sure
  # all have been updated"). While it is, a pull request whose head carries
  # it gets no run -- start one by hand with workflow_dispatch.
  pull_request:
    branches: [main]
    types: [opened, reopened, ready_for_review, synchronize]
  # EVERY PUSH TO MAIN, IN A PUBLIC REPOSITORY ONLY (2026-09-27,
  # spec/BRANCH_TIERS_PLAN.md, "Public repositories test every push to
  # main"). The pull request above tests a change before it lands; this
  # tests what actually landed, and it is the only GitHub test a commit gets
  # when it reaches main without that pull request -- a direct push, an edit
  # on github.com, a bot commit. Morgan: "all pushes to main, on repos that
  # are public, should get the GitHub ci/cd. It doesn't matter that the same
  # check happened (on our server) on local before that, it's a good double
  # check" (strength: decided).
  #
  # When the pushed files are exactly the ones a run of this workflow
  # already passed -- the ordinary merge of a pull request whose head held
  # main -- the skip step below stops after a few seconds instead of
  # testing them again (Morgan, the same day: "it should not run the second
  # time ... if it had just run before, and nothing had changed", strength:
  # decided).
  #
  # The trigger is here in every repository; the job's `if:` below skips it
  # in a private one. A skipped job never gets a runner, so it bills nothing,
  # and a repository that changes visibility gets the right behavior
  # without anyone editing this file.
  push:
    branches: [main]
  workflow_dispatch:

# A second push on the same branch before this finishes cancels the first,
# so an overlapping pair bills once rather than twice.
concurrency:
  group: light-check-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  # To look up whether this workflow already passed on the same files (the
  # skip step below). Read-only.
  actions: read

jobs:
  light-check:
    name: Light check
    # A push to main runs only in a public repository (see `on:` above);
    # the pull request into main and a run started by hand run everywhere.
    if: github.event_name != 'push' || github.event.repository.private != true
    runs-on: ${{ vars.PRECEDENT_RUNNER || 'ubuntu-latest' }}

    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          # fetch-depth 0 clones the whole history, which a check comparing
          # against the base branch needs. One audit found it load-bearing:
          # the checks exited non-zero on a shallow clone. On a repo where
          # the median run is 12 seconds against a 60-second billing floor,
          # a faster checkout would save nothing anyway.
          fetch-depth: 0

      # A PUSH TO MAIN RE-RUNS NOTHING THAT ALREADY PASSED (2026-09-27,
      # spec/BRANCH_TIERS_PLAN.md). Morgan: "we're very cautious about the
      # minutes ... it should not run the second time ... if it had just
      # run before, and nothing had changed" (strength: decided).
      #
      # "Nothing changed" is decided by git, exactly: the pushed commit's
      # files are identical to a commit this same workflow already passed
      # on, and anything else the push brought in was already inside that
      # commit. That is the ordinary Promote merge -- the pull request's
      # head already contains main, so the merge lands the very files its
      # pull-request run tested. Anything short of certain runs the check:
      # main moved in between, no passing run found, the API unreachable,
      # a shallow checkout. A re-run of a push that already passed skips
      # too; start one by hand (workflow_dispatch) to force it.
      - name: Skip if these exact files already passed this check
        id: already
        if: github.event_name == 'push'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -u
          skip=false
          tested=''
          tree=$(git rev-parse "$GITHUB_SHA^{tree}" 2>/dev/null) || tree=''
          parents=$(git rev-list --parents -n 1 "$GITHUB_SHA" 2>/dev/null | cut -s -d' ' -f2-)
          wf=$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID" --jq .workflow_id 2>/dev/null) || wf=''
          if [ -n "$tree" ] && [ -n "$wf" ]; then
            for x in "$GITHUB_SHA" $parents; do
              [ "$(git rev-parse "$x^{tree}" 2>/dev/null)" = "$tree" ] || continue
              covered=true
              for p in $parents; do
                [ "$p" = "$x" ] || git merge-base --is-ancestor "$p" "$x" || covered=false
              done
              [ "$covered" = true ] || continue
              n=$(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/$wf/runs?head_sha=$x&status=success&per_page=1" --jq .total_count 2>/dev/null) || n=0
              if [ "${n:-0}" -gt 0 ] 2>/dev/null; then
                skip=true
                tested=$x
                break
              fi
            done
          fi
          echo "skip=$skip" >> "$GITHUB_OUTPUT"
          if [ "$skip" = true ]; then
            msg="Skipped: these exact files already passed this check on $tested."
          else
            msg="Running: no earlier passing run of this check on these exact files."
          fi
          echo "$msg"
          echo "$msg" >> "$GITHUB_STEP_SUMMARY"

      - name: Set up Python
        if: steps.already.outputs.skip != 'true'
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Locate the vendored engine
        id: engine
        if: steps.already.outputs.skip != 'true'
        run: |
          set -eu
          for candidate in \
            process/upstream/tools \
            tools; do
            if [ -f "$candidate/precedent_check.py" ]; then
              echo "dir=$candidate" >> "$GITHUB_OUTPUT"
              echo "Using $candidate"
              exit 0
            fi
          done
          echo "No vendored engine found at either install model's path" \
               "(process/upstream/tools/ for INSTALL.md section 1," \
               "tools/ for section 0). Either the engine was never" \
               "vendored, or it lives somewhere this workflow does not" \
               "know about -- add that path here and to the two 'paths:'" \
               "lists above." >&2
          exit 1

      - name: Run the light check
        if: steps.already.outputs.skip != 'true'
        run: |
          set -eu
          # The vendored check suite, on a clean machine with none of the
          # session's private sources. A repository's own light check runs
          # in its local push check (practice: two-check-levels), not here.
          python3 "${{ steps.engine.outputs.dir }}/precedent_check.py"
