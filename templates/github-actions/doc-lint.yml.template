# Install as .github/workflows/bestpractice-docs.yml in a dependent repository.
# This version runs the vendored Precedent linter in place.
#
# LAYOUT-AGNOSTIC ON PURPOSE (2026-09-10). This file is one of the artifacts
# INSTALL.md §0 step 5 says to install "unchanged by which install model this
# is", and until that date it was hard-coded to §1's layout: it ran
# `process/upstream/tools/doc_lint.py` and watched that path in its triggers.
# A §0 install has no `process/upstream/` at all -- §0 step 1 puts the engine
# in the repo's own `tools/` -- so the shipped workflow failed on its first
# run and its path filters matched nothing. A red check on the install commit
# is an adopter's first impression of the whole system. Found installing
# precedent-beta-v01 into a real project.
#
# Rather than ship two variants that drift apart, the linter is DISCOVERED at
# run time and every candidate path is watched. Nothing here needs editing
# for either install model.
#
# HOW THIS FILE GOT TO ONE JOB (2026-09-19 and 2026-09-20, practice:
# cite-the-incident). Until 2026-09-19 this was a single job with a debounce
# STEP at the top: the step could skip every step after it, but the job
# itself had already started a runner and checked out the tree to reach that
# decision, and GitHub bills a job for at least one whole minute no matter
# how quickly it finishes. A step-level skip is a cheaper run, not a free
# one. That was correct, and the fix drawn from it was not: the file was
# split into a `debounce` job (always runs, decides) and a `markdown` job
# (`needs: debounce`, `if:` gated), on the reasoning that a job whose `if:`
# evaluates false never allocates a runner and is not billed. True of the
# SKIPPED job, and beside the point -- the deciding job is billed exactly
# like the step was. See "ONE JOB, NOT TWO" further down, and
# precedent-check.yml.template's header for the fuller account and the
# measurement that settled it (spec/CI_MINUTES_PLAN.md item 13).
name: Precedent documentation checks

on:
  # pull_request (opened, synchronize) PLUS push scoped to the branch(es)
  # that actually receive merges -- `main` below is the default a fresh
  # install gets. CUSTOMIZE THE BRANCH LIST if this repo's own routine merge
  # target is not just `main`: Precedent's own equivalent workflow in this
  # repo lists `[main, precedent-beta-v01]`, because routine work here lands
  # on precedent-beta-v01, not main (see GITHUB_ACTIONS.md). Whatever
  # branch(es) a session actually merges into in the repo this installs
  # into, list them here.
  #
  # push only, unrestricted to any branch, was this template's design from
  # 2026-09-15 to 2026-09-19 -- kept deliberately narrow THEN because this
  # template previously shipped both `pull_request:` and `push:` together on
  # every branch, and that measured as exact duplicate runs: 235 runs since
  # 2026-08-28 in matched pairs, each pair billing at least two minutes on a
  # private repo, because a push to a branch with an open PR fired both
  # events for the identical tree. Dropping `pull_request:` fixed the
  # duplicate but reopened a different gap: a branch pushed to directly, no
  # PR yet, got no check at all -- and a different repo's CI caught a real
  # error on an open PR on 2026-09-19, exactly the case that gap gives up on.
  #
  # `pull_request:` is back, scoped differently than the version dropped in
  # 2026-09-15: with push now restricted to the branch(es) named above --
  # none of which is ever a PR's own head branch -- a PR's branch only ever
  # gets pull_request events, and a named branch only ever gets push events
  # (a PR's merge commit landing on main is a push to main, not a
  # synchronize on the now-closed PR branch). Nothing here fires twice for
  # the same commit, so the 2026-08-28 measurement does not reapply.
  #
  # PUT `pull_request:` BACK EVEN WIDER IF THIS REPO EVER TAKES A PR FROM A
  # FORK -- a fork's pushes do not fire `push` in the repo being contributed
  # to at all, on ANY branch, so `pull_request:` (already present above) is
  # what would check it; nothing further to add.
  pull_request:
    types: [opened, synchronize]
    paths:
      - "**/*.md"
      # §1 (vendored under process/upstream/) and §0 (engine in the repo's
      # own tools/). A path that does not exist in this repo simply never
      # matches; listing both costs nothing and is what makes this file
      # portable between the two install models.
      - "process/upstream/tools/doc_lint.py"
      - "tools/doc_lint.py"
      - ".github/workflows/bestpractice-docs.yml"
  push:
    branches: [main]
    paths:
      - "**/*.md"
      - "process/upstream/tools/doc_lint.py"
      - "tools/doc_lint.py"
      - ".github/workflows/bestpractice-docs.yml"
  workflow_dispatch:

# CONCURRENCY, so a burst of pushes to the same branch does not pay for
# every run in the burst (2026-09-15). If a second run starts on this
# branch while an earlier one is still going, GitHub cancels the earlier
# one instead of billing both to completion. This only helps the OVERLAP
# case -- two pushes close enough together that the first run had not
# finished yet. This job runs well under a minute, so a steady stream of
# saves spaced further apart than that has nothing in flight to cancel --
# this is a cheap backstop, not the fix for a repo pushed to constantly.
# For that, see doc-lint-scheduled.yml.template, which trades per-push
# billing for a fixed cadence. GITHUB_ACTIONS.md says which to install.
concurrency:
  group: docs-${{ github.ref }}
  cancel-in-progress: true

# ONE JOB, NOT TWO (2026-09-20). This file carried a `debounce` job whose
# output gated the markdown job below via `needs:` + `if:`. A job whose
# `if:` evaluates false is never billed -- but the job that DECIDES is
# billed like any other, so with S the fraction of triggers the window
# skips, the two shapes cost:
#
#   debounce job + markdown job:  S x 1 + (1-S) x 2  =  2 - S
#   markdown job alone:                                     1
#
# 2 - S > 1 for every S below 1: the debounce job could not pay for itself
# at any window setting. It is gone, along with `ci_debounce_minutes` and
# the `actions: read` scope it needed to list this workflow past runs. The
# `paths:` filter above does the same job for free -- GitHub evaluates it
# before allocating any runner, so a push touching no Markdown costs
# nothing at all, which no debounce window could ever match.
# precedent-check.yml.template header has the full account and the timings
# that settled it.

permissions:
  contents: read

# RUNNER, OVERRIDABLE PER REPO (2026-09-20). The single job below runs on
# `ubuntu-latest` unless this repo declares a `PRECEDENT_RUNNER` repository
# variable (Settings -> Secrets and variables -> Actions -> Variables) --
# e.g. `self-hosted`, for an adopter who already operates their own runner.
# Left unset, nothing here changes. This is an adopter's own opt-in, not
# something Precedent can provide for them: a self-hosted runner means
# their code executing on infrastructure they control, which nobody else
# can stand up on their behalf. spec/CI_MINUTES_PLAN.md item 6 has the
# trade-offs; GITHUB_ACTIONS.md's "Controlling Actions Minutes" is where
# this variable is documented alongside the levers that need no opt-in at
# all (ci_workflows disabled by default, branch scoping, one job per run).
jobs:
  markdown:
    name: Markdown lint
    runs-on: ${{ vars.PRECEDENT_RUNNER || 'ubuntu-latest' }}

    steps:
      # The PR HEAD, not refs/pull/N/merge -- auditing the merge tree
      # reports findings belonging to neither branch, which the author
      # cannot act on. Empty (a push event, not pull_request) falls back to
      # actions/checkout's own default, the triggering ref -- correct for a
      # push to a named branch above.
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Markdown parser
        run: python -m pip install cmarkgfm

      - name: Locate the vendored linter
        id: linter
        run: |
          set -eu
          for candidate in \
            process/upstream/tools/doc_lint.py \
            tools/doc_lint.py; do
            if [ -f "$candidate" ]; then
              echo "path=$candidate" >> "$GITHUB_OUTPUT"
              echo "Using $candidate"
              exit 0
            fi
          done
          echo "No vendored doc_lint.py found at either install model's" \
               "path (process/upstream/tools/ for INSTALL.md §1," \
               "tools/ for §0). Either the engine was never vendored, or" \
               "it lives somewhere this workflow does not know about --" \
               "add that path here and to the two 'paths:' lists above." >&2
          exit 1

      - name: Lint changed Markdown
        run: python3 "${{ steps.linter.outputs.path }}"
