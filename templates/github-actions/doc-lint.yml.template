# Install as .github/workflows/bestpractice-docs.yml in a dependent repository.
# This version runs the vendored Precedent linter in place.
#
# LAYOUT-AGNOSTIC ON PURPOSE (2026-09-10). This file is one of the artifacts
# INSTALL.md §0 step 5 says to install "unchanged by which install model this
# is", and until that date it was hard-coded to §1's layout: it ran
# `process/upstream/tools/doc_lint.py` and watched that path in its triggers.
# A §0 install has no `process/upstream/` at all -- §0 step 1 puts the engine
# in the repo's own `tools/` -- so the shipped workflow failed on its first
# run and its path filters matched nothing. A red check on the install commit
# is an adopter's first impression of the whole system. Found installing
# precedent-beta-v01 into a real project.
#
# Rather than ship two variants that drift apart, the linter is DISCOVERED at
# run time and every candidate path is watched. Nothing here needs editing
# for either install model.
name: Precedent documentation checks

on:
  # push only, deliberately -- matching this repo's own docs.yml,
  # deep-check.yml and leak-gate.yml (2026-09-15). Until then this template
  # shipped both `pull_request:` and `push:` on the same path filters, kept
  # on the reasoning that a dependent repo is one "nobody here controls," so
  # a fork PR there would go unchecked without `pull_request:` -- a fork's
  # push never fires `push` in the repo being contributed to. That reasoning
  # is real for a repo that takes outside contributions, which this one
  # does; it is dead weight for what this template actually ships into most
  # often, a private, single-maintainer install with no fork traffic at
  # all. There every push to an open PR fired the pull_request run, and
  # merging fired the push run again on the same resulting tree, seconds
  # apart -- measured directly in one dependent repo's installed copy: 235
  # runs since 2026-08-28, in matched pairs, each pair billing at least two
  # minutes on a private repo (GitHub rounds each job up to one minute).
  # Nothing was gained for that cost: check runs attach to the head SHA
  # whatever event produced them, so the PR still shows the push run's
  # result, and the merge commit gets its own run on the base branch
  # afterwards -- the only run that tests what actually landed.
  #
  # PUT `pull_request:` BACK IF THIS REPO EVER TAKES A PR FROM A FORK -- a
  # fork's pushes do not fire `push` in the repo being contributed to, so
  # `pull_request:` is the only trigger that would check it.
  push:
    paths:
      - "**/*.md"
      # §1 (vendored under process/upstream/) and §0 (engine in the repo's
      # own tools/). A path that does not exist in this repo simply never
      # matches; listing both costs nothing and is what makes this file
      # portable between the two install models.
      - "process/upstream/tools/doc_lint.py"
      - "tools/doc_lint.py"
      - ".github/workflows/bestpractice-docs.yml"
  workflow_dispatch:

# CONCURRENCY, so a burst of pushes to the same branch does not pay for
# every run in the burst (2026-09-15). If a second run starts on this
# branch while an earlier one is still going, GitHub cancels the earlier
# one instead of billing both to completion. This only helps the OVERLAP
# case -- two pushes close enough together that the first run had not
# finished yet. This job runs well under a minute, so a steady stream of
# saves spaced further apart than that has nothing in flight to cancel --
# this is a cheap backstop, not the fix for a repo pushed to constantly.
# For that, see doc-lint-scheduled.yml.template, which trades per-push
# billing for a fixed cadence. GITHUB_ACTIONS.md says which to install.
concurrency:
  group: docs-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  actions: read

jobs:
  markdown:
    name: Markdown lint
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # DEBOUNCE (2026-09-16), for the steady-drip case concurrency's own
      # comment above says it cannot reach: a repo pushed to every few
      # minutes pays for a full check on every one of them even with no two
      # runs ever overlapping. Reads `ci_debounce_minutes` from
      # precedent.json (default 360 = 6 hours; 0 disables it) and skips the
      # rest of this job when the last COMPLETED run on this branch
      # finished inside that window -- spec/CI_MINUTES_PLAN.md's item 4.
      # This is an advisory check (a broken link sits uncaught for at most
      # one window); a workflow standing in for a security backstop should
      # not carry this step at all.
      - name: Skip if checked recently (debounce)
        id: debounce
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -eu
          minutes="$(python3 - <<'PY'
          import json, pathlib
          try:
              d = json.loads(pathlib.Path('precedent.json').read_text())
          except (OSError, ValueError):
              d = {}
          try:
              v = int(d.get('ci_debounce_minutes', 360))
          except (TypeError, ValueError):
              v = 360
          print(v)
          PY
          )"
          if [ "$minutes" -le 0 ]; then
            echo "ci_debounce_minutes: $minutes -- debounce off, running"
            echo "skip=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          last="$(gh run list --workflow "${{ github.workflow }}" \
                   --branch "${{ github.ref_name }}" --status completed \
                   --limit 1 --json updatedAt --jq '.[0].updatedAt // empty' \
                   2>/dev/null || true)"
          if [ -z "$last" ]; then
            echo "no prior completed run on this branch -- running"
            echo "skip=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          elapsed=$(( ($(date -u +%s) - $(date -u -d "$last" +%s)) / 60 ))
          if [ "$elapsed" -lt "$minutes" ]; then
            echo "last completed run was ${elapsed}m ago, inside the " \
                 "${minutes}m window -- skipping"
            echo "skip=true" >> "$GITHUB_OUTPUT"
          else
            echo "last completed run was ${elapsed}m ago, outside the " \
                 "${minutes}m window -- running"
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Set up Python
        if: steps.debounce.outputs.skip != 'true'
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Markdown parser
        if: steps.debounce.outputs.skip != 'true'
        run: python -m pip install cmarkgfm

      - name: Locate the vendored linter
        if: steps.debounce.outputs.skip != 'true'
        id: linter
        run: |
          set -eu
          for candidate in \
            process/upstream/tools/doc_lint.py \
            tools/doc_lint.py; do
            if [ -f "$candidate" ]; then
              echo "path=$candidate" >> "$GITHUB_OUTPUT"
              echo "Using $candidate"
              exit 0
            fi
          done
          echo "No vendored doc_lint.py found at either install model's" \
               "path (process/upstream/tools/ for INSTALL.md §1," \
               "tools/ for §0). Either the engine was never vendored, or" \
               "it lives somewhere this workflow does not know about --" \
               "add that path here and to the two 'paths:' lists above." >&2
          exit 1

      - name: Lint changed Markdown
        if: steps.debounce.outputs.skip != 'true'
        run: python3 "${{ steps.linter.outputs.path }}"
