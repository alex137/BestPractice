# Install as .github/workflows/bestpractice-docs.yml in a dependent repository.
# This version runs the vendored BestPractice linter in place.
name: BestPractice documentation checks

on:
  pull_request:
    paths:
      - "**/*.md"
      - "process/upstream/tools/doc_lint.py"
      - ".github/workflows/bestpractice-docs.yml"
  push:
    branches:
      - main
    paths:
      - "**/*.md"
      - "process/upstream/tools/doc_lint.py"
      - ".github/workflows/bestpractice-docs.yml"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  markdown:
    name: Markdown lint
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Markdown parser
        run: python -m pip install cmarkgfm

      - name: Lint changed Markdown
        run: python3 process/upstream/tools/doc_lint.py
