# Install as .github/workflows/bestpractice-docs.yml IN PLACE OF
# doc-lint.yml.template -- never alongside it, which would bill both. See
# GITHUB_ACTIONS.md, "Controlling Actions minutes", for when to pick this
# variant instead of the default.
#
# WHO THIS IS FOR (2026-09-15). doc-lint.yml.template bills roughly once per
# push, which is the right shape for a repo that reviews changes through
# pull requests. It is the wrong shape for a repo where "commit" means
# "save" -- pushed straight to the default branch, many times an hour -- on
# a private repository, where minutes are metered and rounded up per run.
# This variant bills on a fixed cadence instead: however many saves land in
# one window, they cost one run.
#
# NOT THE SHIPPED DEFAULT, ON PURPOSE. GITHUB_ACTIONS.md's own Limits
# section already names the reason: "a `schedule:` inherited by every
# adopter is a clock in somebody else's repository that they never picked."
# precedent_install.py never installs this file; an adopter who wants it
# copies it over the default, deliberately, and sets their own cadence
# below. The trade this makes is explicit, not inherited: pushes stop
# getting per-push feedback, in exchange for a bounded, predictable bill.
#
# THE CRON BELOW IS A STARTING POINT, NOT A RECOMMENDATION -- pick a cadence
# that matches how you actually save and what you're willing to spend.
# GitHub also does not guarantee scheduled runs fire exactly on time under
# load, so treat this as approximate.
name: Precedent documentation checks (scheduled)

on:
  schedule:
    - cron: "0 * * * *"   # hourly; edit to fit how often you actually push
  workflow_dispatch:

# Same reasoning as doc-lint.yml.template's concurrency block: if the
# previous scheduled run is somehow still going when the next one fires
# (or someone triggers workflow_dispatch mid-run), cancel it rather than
# billing both. Less likely to matter on a fixed cadence than on pushes,
# but it costs nothing to have.
concurrency:
  group: docs-scheduled-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  markdown:
    name: Markdown lint (scheduled)
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Markdown parser
        run: python -m pip install cmarkgfm

      - name: Locate the vendored linter
        id: linter
        run: |
          set -eu
          for candidate in \
            process/upstream/tools/doc_lint.py \
            tools/doc_lint.py; do
            if [ -f "$candidate" ]; then
              echo "path=$candidate" >> "$GITHUB_OUTPUT"
              echo "Using $candidate"
              exit 0
            fi
          done
          echo "No vendored doc_lint.py found at either install model's" \
               "path (process/upstream/tools/ for INSTALL.md §1," \
               "tools/ for §0). Either the engine was never vendored, or" \
               "it lives somewhere this workflow does not know about --" \
               "add that path here." >&2
          exit 1

      # WHY EVERY TRACKED FILE, NOT doc_lint.py's DEFAULT "what changed".
      # doc_lint.py with no arguments lints what changed relative to
      # origin/<default branch> -- the right scope for a pull request, and
      # a silent no-op here: by the time a scheduled run checks out the
      # default branch, HEAD usually already IS origin/<default branch>,
      # so that diff comes up empty and nothing gets gated. doc_lint.py's
      # own --all flag avoids that by scanning everything, but it also
      # turns off the gate on purpose (so a legacy corpus never blocks) --
      # exactly wrong for a periodic check whose one job is to fail loudly.
      # Passing every tracked path as an explicit argument gets both: full
      # coverage AND a real gate (doc_lint.py's own contract: explicit
      # paths always gate). The cost is that a newly-adopted repo with an
      # existing backlog of violations fails here until it is clean --
      # correct for a small, freshly-installed project; run doc_lint.py
      # locally first if you are adopting this onto an older tree.
      - name: Lint every tracked Markdown file
        run: |
          set -eu
          mapfile -t files < <(git ls-files '*.md')
          if [ "${#files[@]}" -eq 0 ]; then
            echo "No tracked Markdown files."
            exit 0
          fi
          python3 "${{ steps.linter.outputs.path }}" "${files[@]}"
