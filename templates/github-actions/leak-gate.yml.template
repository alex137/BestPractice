# Install as .github/workflows/leak-gate.yml in a dependent repository or
# a practice-set source. Runs tools/leak_gate.py --structural-only (never
# the vocabulary layer -- this runner has no private blocklist and never
# will, same reasoning as BestPractice's own .github/workflows/leak-gate.yml,
# which this template is derived from).
#
# FIRST TIME THIS HAS BEEN VENDORED AT ALL (2026-09-20, spec/CI_MINUTES_PLAN.md
# item 12). Until now leak-gate.yml existed only in this repo, unconditionally
# on every branch, justified by this repo being PUBLIC: "a leak on any branch
# is already published" (item 2b). That reasoning does not transfer to a
# private dependent repo as-is -- the audience of an early leak there is
# whoever already has repo access, not the public internet -- so this
# template does not just copy BestPractice's own scope. It reads this repo's
# own declared visibility and narrows accordingly.
#
# WHY A JOB-LEVEL `if:`, NOT A NARROWED `on: push: branches:` LIST, THE WAY
# doc-lint.yml.template AND precedent-check.yml.template DO IT. Those two
# templates can hardcode their branch list because GitHub Actions evaluates
# `on:` before any job runs, from the YAML alone -- it cannot read this
# repo's config at that point, so "scope the trigger by what precedent.json
# says" is not an option the platform offers. Reading `visibility` has to
# happen inside a job, which means the workflow is triggered on every push
# regardless, and the FIRST job decides whether the real scan runs. Per
# spec/CI_MINUTES_PLAN.md item 9's own lesson: that decision is its own job,
# never a step inside one that already started, because GitHub bills a job
# for at least one runner-minute the moment it starts regardless of how fast
# an early step exits -- a job whose own `if:` evaluates false is reported
# SKIPPED and never allocates a runner at all.
#
# THE TRADE, STATED PLAINLY, NOT LEFT IMPLICIT. On a repo declaring
# `"visibility": "private"`, a push to any branch other than the declared
# `base_branch` (default `main`) skips the real scan -- caught only if the
# local pre-push hook ran (templates/hooks/pre-push's own header calls that
# hook "the complete gate" for exactly this reason: it can load a private
# blocklist this server-side runner never can). A secret pushed to a
# throwaway branch and never merged is not caught here until that branch
# either reaches `base_branch` or is scanned by a `workflow_dispatch` run.
# This is the same trade spec/CI_MINUTES_PLAN.md item 8 already made for four
# real repos when branch volume was the measured cost driver -- generalized
# here into a template instead of a one-off hand edit. A `pull_request:`
# event is NEVER skipped by this logic, whatever branch it is against --
# that is the moment a fork's contribution or a feature branch's merge
# candidate actually gets scanned before landing, and it is also how this
# template still catches a PR from a fork (a fork's pushes do not fire
# `push:` in the repo it targets at all).
#
# ON A PUBLIC REPO (visibility absent, or declared "public"), nothing above
# changes anything: the gate step below evaluates true on every push to
# every branch, matching BestPractice's own leak-gate.yml exactly, because a
# leak on a public repo is already published the instant it is pushed,
# whichever branch it landed on.
#
# WHERE visibility AND base_branch COME FROM. A dependent (consumer) repo
# declares both in `precedent.json` (absent visibility defaults to "public",
# matching build_views.py's own repo_is_public convention; absent
# base_branch defaults to "main"). A practice-set SOURCE repo has no
# precedent.json -- its `precedent-source.json` always declares
# `"visibility": "private"` (precedent_bootstrap_source.py's
# _write_source_manifest writes it unconditionally, since a practice set's
# own practice text is never meant to be public), and has no base_branch
# field to read, so this template defaults it to "main" there, matching
# every other template's own default merge target.
on:
  push:
  pull_request:
    types: [opened, synchronize]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  # ONE job, so "does this ref need scanning" is billed once and the real
  # scan job is skipped for free (never started) when it decides not to run
  # -- same shape as doc-lint.yml.template's debounce job and
  # precedent-check.yml.template's debounce job.
  scope:
    name: Decide whether this push needs scanning
    runs-on: ${{ vars.PRECEDENT_RUNNER || 'ubuntu-latest' }}
    outputs:
      run: ${{ steps.gate.outputs.run }}
    steps:
      # No fetch-depth override -- this job only reads a config file out of
      # the working tree, never git history, so the default shallow
      # checkout is enough. The leak-gate job below takes its own checkout
      # when it actually runs.
      - uses: actions/checkout@v4

      - name: Read this repo's declared visibility and base branch
        id: scope
        run: |
          set -eu
          python3 - <<'PY' >> "$GITHUB_OUTPUT"
          import json, pathlib

          visibility = None
          base_branch = None

          consumer = pathlib.Path('precedent.json')
          source = pathlib.Path('precedent-source.json')
          if consumer.exists():
              try:
                  d = json.loads(consumer.read_text())
              except (OSError, ValueError):
                  d = {}
              visibility = d.get('visibility')
              base_branch = d.get('base_branch')
          elif source.exists():
              try:
                  d = json.loads(source.read_text())
              except (OSError, ValueError):
                  d = {}
              visibility = d.get('visibility', 'private')

          if visibility not in ('public', 'private'):
              visibility = 'public'
          if not base_branch or not isinstance(base_branch, str):
              base_branch = 'main'

          print(f'visibility={visibility}')
          print(f'base_branch={base_branch}')
          PY

      # NEVER skip a pull_request event, whatever branch it targets or comes
      # from -- see the header comment. Only a `push` to a private repo's
      # non-primary branch is the case this narrows.
      - name: Decide whether the real scan runs
        id: gate
        env:
          EVENT: ${{ github.event_name }}
          REF_NAME: ${{ github.ref_name }}
          VISIBILITY: ${{ steps.scope.outputs.visibility }}
          BASE_BRANCH: ${{ steps.scope.outputs.base_branch }}
        run: |
          set -eu
          if [ "$EVENT" != "push" ] || [ "$VISIBILITY" != "private" ] || \
             [ "$REF_NAME" = "$BASE_BRANCH" ]; then
            echo "scanning (visibility=$VISIBILITY, event=$EVENT, ref=$REF_NAME, base=$BASE_BRANCH)"
            echo "run=true" >> "$GITHUB_OUTPUT"
          else
            echo "private repo, push to '$REF_NAME' (not '$BASE_BRANCH') -- " \
                 "skipping the server-side scan; the local pre-push hook is " \
                 "this branch's only gate until it reaches $BASE_BRANCH"
            echo "run=false" >> "$GITHUB_OUTPUT"
          fi

  leak-gate:
    name: Leak gate (structural)
    needs: scope
    if: needs.scope.outputs.run == 'true'
    runs-on: ${{ vars.PRECEDENT_RUNNER || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # --structural-only, by name and on purpose. This runner has no private
      # blocklist and never will, so the vocabulary layer cannot run here --
      # same reasoning as BestPractice's own leak-gate.yml.
      - name: Run the leak gate over the tracked tree (structural half only)
        run: python3 tools/leak_gate.py --structural-only
