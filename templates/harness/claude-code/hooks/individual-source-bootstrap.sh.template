#!/bin/bash
# PRECEDENT HOOK STUB, individual-source form. Instantiated once per person by
# tools/precedent_bootstrap_source.py, which fills in the three values below,
# and never changed after: everything this hook does is in the engine's
# tools/individual-source-bootstrap.sh, which Update Vendors keeps current.
#
# WHY (Morgan, 2026-10-07, strength: decided: "It should no longer ask").
# Claude Code's auto mode holds any commit that changes a file under .claude/
# until the person says yes, and this hook's logic changed on 4 days in the
# month before; each change reached every repository through the individual
# set's adapter, as a question. Only what is the person's own stays here.
export PRECEDENT_INDIVIDUAL_SOURCE_NAME="{{SOURCE_NAME}}"
export PRECEDENT_INDIVIDUAL_DEFAULT_URL="{{SOURCE_REPO_URL}}"
export PRECEDENT_INDIVIDUAL_SUBSTITUTED="{{SOURCE_REPO_URL_SUBSTITUTED}}"
here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
export PRECEDENT_HOOK_HERE="$here"
# Where the script is: two levels up in a consumer (.claude/hooks/), one in
# the individual set itself (bootstrap/), else the project Claude Code names,
# else -- the raw template inside BestPractice -- four levels up.
for real in "$here/../../tools/individual-source-bootstrap.sh" \
            "$here/../tools/individual-source-bootstrap.sh" \
            "${CLAUDE_PROJECT_DIR:-/nonexistent}/tools/individual-source-bootstrap.sh" \
            "$here/../../../../tools/individual-source-bootstrap.sh"; do
  if [[ -f "$real" ]]; then
    exec bash "$real" "$@"
  fi
done
echo "NOTE: individual-source bootstrap: tools/individual-source-bootstrap.sh is not here, so your individual practices were not set up this session. Update Vendors brings it." >&2
exit 0
